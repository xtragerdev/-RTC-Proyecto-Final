NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/renodo
MONGO_AUTO_INDEX=true
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-32-caracteres
JWT_EXPIRES_IN=7d
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# Opcional: si no están definidas, la API funciona salvo la subida de imágenes.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=renodo

# Obligatoria al ejecutar npm run seed en producción.
SEED_USER_PASSWORD=
# SEED_CSV_DIR=../../data/csv
